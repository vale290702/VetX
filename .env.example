# Local development only. Replace example credentials in shared environments.
API_PORT=4000
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:4000
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# Update the connection URLs when changing the database name, port or passwords.
# Percent-encode reserved characters in the URL passwords.
POSTGRES_DB=vetx
POSTGRES_PORT=56432
POSTGRES_PASSWORD=vetx-local-bootstrap-only
POSTGRES_MIGRATION_PASSWORD=vetx-local-migration-only
POSTGRES_RUNTIME_PASSWORD=vetx-local-runtime-only
DATABASE_URL=postgresql://vetx_runtime:vetx-local-runtime-only@127.0.0.1:56432/vetx
DIRECT_DATABASE_URL=postgresql://vetx_migration:vetx-local-migration-only@127.0.0.1:56432/vetx

REDIS_PORT=56379
REDIS_PASSWORD=vetx-local-redis-only

# Local identity provider
KEYCLOAK_PORT=58080
KEYCLOAK_MEMORY_LIMIT=1g
KEYCLOAK_ADMIN=vetx
KEYCLOAK_ADMIN_PASSWORD=vetx-local-keycloak-only
KEYCLOAK_PUBLIC_ORIGIN=http://127.0.0.1:58080
OIDC_ISSUER_URL=http://127.0.0.1:58080/realms/vetx
OIDC_API_CLIENT_ID=vetx-api
OIDC_API_CLIENT_SECRET=vetx-local-introspection-only
OIDC_WEB_CLIENT_ID=vetx-web
OIDC_WEB_CLIENT_SECRET=vetx-local-web-only
OIDC_STAFF_CLIENT_ID=vetx-staff
OIDC_OWNER_CLIENT_ID=vetx-pets
WEB_PUBLIC_ORIGIN=http://127.0.0.1:3000
WEB_REDIS_URL=redis://:vetx-local-redis-only@127.0.0.1:56379
MAILPIT_PORT=58025
EXPO_PUBLIC_OIDC_ISSUER_URL=http://127.0.0.1:58080/realms/vetx
EXPO_PUBLIC_OIDC_STAFF_CLIENT_ID=vetx-staff
EXPO_PUBLIC_OIDC_OWNER_CLIENT_ID=vetx-pets

# Patient linking. The local setup command generates the HMAC secret for this installation.
PET_LINK_HMAC_KEY_HEX=
PET_LINK_LIFETIME_SECONDS=86400
PET_LINK_ATTEMPT_LIMIT=8
PET_LINK_WINDOW_SECONDS=900

# Optional Compose integrations profile
S3_PORT=59000
S3_ACCESS_KEY=vetx-local-storage
S3_SECRET_KEY=vetx-local-storage-only
ORTHANC_HTTP_PORT=58042
ORTHANC_DICOM_PORT=54242
ORTHANC_REGISTERED_USERS='{"vetx":"vetx-local-orthanc-only"}'

# Private clinical document storage. Use workplace IAM credentials or a secrets manager outside local development.
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=vetx-clinical-documents
DOCUMENT_MAX_BYTES=10485760
