{
  "name": "@vetx/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --signal SIGTERM --exec 'pnpm build && pnpm start'",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "start": "node dist/main.js",
    "openapi:generate": "node dist/generate-openapi.js",
    "storage:init": "node scripts/init-document-bucket.mjs",
    "test:imaging": "node --test integration/imaging.test.mjs",
    "test:storage": "node --test integration/storage.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@vetx/auth": "workspace:*",
    "@vetx/config": "workspace:*",
    "@vetx/database": "workspace:*",
    "@vetx/exchange": "workspace:*",
    "@vetx/fiscal-cr": "workspace:*",
    "@vetx/permissions": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "nodemon": "3.1.14",
    "typescript": "5.9.3"
  }
}
