{
  "name": "@vetx/config",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./public": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
