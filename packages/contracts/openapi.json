  "info": {
    "title": "VetX API",
    "description": "",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "BAD_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "LAST_ORGANIZATION_ADMIN",
              "TOO_MANY_REQUESTS",
              "SERVICE_UNAVAILABLE",
              "INTERNAL_ERROR",
              "HTTP_ERROR"
            ]
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetailDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "ResourceSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceSummaryDto"
            }
          }
        },
        "required": [
          "subject",
          "organizations"
        ]
      },
      "ClinicListDto": {
        "type": "object",
        "properties": {
          "clinics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceSummaryDto"
            }
          }
        },
        "required": [
          "clinics"
        ]
      },
      "DirectoryMemberDto": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "STAFF"
            ]
          },
          "clinicIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "subject",
          "role",
          "clinicIds"
        ]
      },
      "AdministrationDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "clinics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceSummaryDto"
            }
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DirectoryMemberDto"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "hasNextPage": {
            "type": "boolean"
          }
        },
        "required": [
          "revision",
          "clinics",
          "members",
          "page",
          "hasNextPage"
        ]
      },
      "ClinicUpdateDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "revision",
          "name"
        ]
      },
      "DirectoryRevisionDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "required": [
          "revision"
        ]
      },
      "MemberAccessDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "STAFF"
            ]
          },
          "clinicIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "revision",
          "subject",
          "role",
          "clinicIds"
        ]
      },
      "MemberIdentityDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "revision",
          "subject"
        ]
      }
    }
  }
}
