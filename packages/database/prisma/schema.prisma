generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  petLinkLifetimeSeconds Int? @map("pet_link_lifetime_seconds")
  directoryRevision Int @default(0) @map("directory_revision")
  clinics     Clinic[]
  memberships OrganizationMembership[]
  directoryEvents DirectoryEvent[]

  @@map("organizations")
}

model Clinic {
  exchangePackages ExchangePackage[]
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  patients Patient[]
  warehouses InventoryWarehouse[]
  stockItems InventoryItem[]
  incomingReferrals ReferralState[]
  ownerContacts OwnerContact[]
  grants         ClinicGrant[]

  @@unique([organizationId, id])
  @@map("clinics")
}

model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityIssuer  String   @map("identity_issuer")
  identitySubject String   @map("identity_subject")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships     OrganizationMembership[]

  @@unique([identityIssuer, identitySubject])
  @@map("users")
}

enum OrganizationRole {
  ADMIN
  STAFF

  @@map("organization_role")
}

model OrganizationMembership {
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicGrants   ClinicGrant[]

  @@id([organizationId, userId])
  @@index([userId, organizationId])
  @@map("organization_memberships")
}

model ClinicGrant {
  organizationId String                 @map("organization_id") @db.Uuid
  clinicId       String                 @map("clinic_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  membership     OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  clinic         Clinic                 @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, clinicId, userId])
  @@index([organizationId, userId])
  @@map("clinic_grants")
}

model DirectoryEvent {
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision       Int
  actorIssuer    String       @map("actor_issuer")
  actorSubject   String       @map("actor_subject")
  action         String
  target         String
  details        Json         @db.JsonB
  recordedAt     DateTime     @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)

  @@id([organizationId, revision])
  @@map("directory_events")
}

model Patient {
  exchangeMappings ExchangePatient[]
  exports ExchangeExportEvent[]
  organizationId String          @map("organization_id") @db.Uuid
  clinicId       String          @map("clinic_id") @db.Uuid
  id             String          @db.Uuid
  name           String
  species        String
  birthDate      DateTime?       @map("birth_date") @db.Date
  revision       Int             @default(1)
  clinic         Clinic          @relation(fields: [organizationId, clinicId], references: [organizationId, id], onUpdate: NoAction, onDelete: NoAction)
  guardians      Guardian[]
  events         RegistryEvent[]
  documents MedicalDocument[]
  encounters     ClinicalEncounter[]
  appointments   Appointment[]
  careEvents     CareEvent[]

  @@id([organizationId, clinicId, id])
  @@map("patients")
}

model OwnerContact {
  organizationId String     @map("organization_id") @db.Uuid
  clinicId       String     @map("clinic_id") @db.Uuid
  id             String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  email          String
  clinic         Clinic     @relation(fields: [organizationId, clinicId], references: [organizationId, id], onUpdate: NoAction, onDelete: NoAction)
  guardians      Guardian[]

  @@id([organizationId, clinicId, id])
  @@unique([organizationId, clinicId, email])
  @@map("owner_contacts")
}

model Guardian {
  organizationId  String       @map("organization_id") @db.Uuid
  clinicId        String       @map("clinic_id") @db.Uuid
  patientId       String       @map("patient_id") @db.Uuid
  id              String       @db.Uuid
  contactId       String       @map("contact_id") @db.Uuid
  removedAt       DateTime?    @map("removed_at") @db.Timestamptz(3)
  issueRequestId  String?      @map("issue_request_id") @db.Uuid
  digest          String?
  expiresAt       DateTime?    @map("expires_at") @db.Timestamptz(3)
  recipientIssuer String?      @map("recipient_issuer")
  recipientEmail  String?      @map("recipient_email")
  ownerSubject    String?      @map("owner_subject")
  petId           String?      @map("pet_id") @db.Uuid
  claimRequestId  String?      @map("claim_request_id") @db.Uuid
  claimTarget     String?      @map("claim_target") @db.Uuid
  referralStates  ReferralState[]
  releases        EncounterRecipient[]
  patient         Patient      @relation(fields: [organizationId, clinicId, patientId], references: [organizationId, clinicId, id], onUpdate: NoAction, onDelete: NoAction)
  contact         OwnerContact @relation(fields: [organizationId, clinicId, contactId], references: [organizationId, clinicId, id], onUpdate: NoAction, onDelete: NoAction)

  @@id([organizationId, clinicId, patientId, id])
  @@map("guardians")
}

model RegistryEvent {
  id             BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id") @db.Uuid
  clinicId       String   @map("clinic_id") @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  guardianId     String?  @map("guardian_id") @db.Uuid
  actorIssuer    String   @map("actor_issuer")
  actorSubject   String   @map("actor_subject")
  action         String
  requestId      String?  @map("request_id") @db.Uuid
  recordedAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  patient        Patient  @relation(fields: [organizationId, clinicId, patientId], references: [organizationId, clinicId, id], onUpdate: NoAction, onDelete: NoAction)

  @@map("registry_events")
}

model PetLinkAttempt {
  issuer      String
  subject     String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  failures    Int      @default(0)

  @@id([issuer, subject])
  @@map("pet_link_attempts")
}

model ClinicalEncounter {
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  patientId      String @map("patient_id") @db.Uuid
  id             String @db.Uuid
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  recordedAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  authorIssuer   String @map("author_issuer")
  authorSubject  String @map("author_subject")
  reason         String
  subjective     String
  objective      String
  assessment     String
  plan           String
  addendumTo     String? @map("addendum_to") @db.Uuid
  patient        Patient @relation(fields: [organizationId, clinicId, patientId], references: [organizationId, clinicId, id], onUpdate: NoAction, onDelete: NoAction)
  original       ClinicalEncounter? @relation("EncounterAddenda", fields: [organizationId, clinicId, patientId, addendumTo], references: [organizationId, clinicId, patientId, id], onUpdate: NoAction, onDelete: NoAction)
  addenda        ClinicalEncounter[] @relation("EncounterAddenda")
  sharing        EncounterSharing?

  @@id([organizationId, clinicId, patientId, id])
  @@index([organizationId, clinicId, patientId, occurredAt(sort: Desc), id], map: "encounters_chronology")
  @@map("clinical_encounters")
}

model EncounterSharing {
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  patientId      String @map("patient_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid
  revision       Int
  actorIssuer    String @map("actor_issuer")
  actorSubject   String @map("actor_subject")
  encounter      ClinicalEncounter @relation(fields: [organizationId, clinicId, patientId, encounterId], references: [organizationId, clinicId, patientId, id], onUpdate: NoAction, onDelete: NoAction)
  recipients     EncounterRecipient[]

  @@id([organizationId, clinicId, patientId, encounterId])
  @@map("encounter_sharing")
}

model EncounterRecipient {
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  patientId      String @map("patient_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid
  guardianId     String @map("guardian_id") @db.Uuid
  sharing        EncounterSharing @relation(map: "recipients_sharing_fk", fields: [organizationId, clinicId, patientId, encounterId], references: [organizationId, clinicId, patientId, encounterId], onUpdate: NoAction, onDelete: NoAction)
  guardian       Guardian @relation(map: "recipients_guardian_fk", fields: [organizationId, clinicId, patientId, guardianId], references: [organizationId, clinicId, patientId, id], onUpdate: NoAction, onDelete: NoAction)

  @@id([organizationId, clinicId, patientId, encounterId, guardianId])
  @@index([organizationId, clinicId, patientId, guardianId, encounterId], map: "encounter_recipient_lookup")
  @@map("encounter_recipients")
}

model Appointment {
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  id             String @db.Uuid
  patientId      String @map("patient_id") @db.Uuid
  startAt        DateTime @map("start_at") @db.Timestamptz(3)
  endAt          DateTime @map("end_at") @db.Timestamptz(3)
  reason         String
  status         String
  revision       Int @default(1)
  actorIssuer    String @map("actor_issuer")
  actorSubject   String @map("actor_subject")
  patient        Patient @relation(fields: [organizationId, clinicId, patientId], references: [organizationId, clinicId, id], onUpdate: NoAction, onDelete: NoAction)

  @@id([organizationId, clinicId, id])
  @@index([organizationId, clinicId, startAt, id], map: "appointment_calendar")
  @@map("appointments")
}

model CareEvent {
  id             BigInt @id @default(autoincrement())
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  patientId      String @map("patient_id") @db.Uuid
  resourceId     String @map("resource_id") @db.Uuid
  action         String
  details        Json @db.JsonB
  actorIssuer    String @map("actor_issuer")
  actorSubject   String @map("actor_subject")
  recordedAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  patient        Patient @relation(fields: [organizationId, clinicId, patientId], references: [organizationId, clinicId, id], onUpdate: NoAction, onDelete: NoAction)

  @@map("care_events")
}

model ReferralState {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId        String @map("request_id") @db.Uuid
  sourceOrg        String @map("source_org") @db.Uuid
  sourceClinic     String @map("source_clinic") @db.Uuid
  patientId        String @map("patient_id") @db.Uuid
  guardianId       String @map("guardian_id") @db.Uuid
  destinationOrg   String @map("destination_org") @db.Uuid
  destinationClinic String @map("destination_clinic") @db.Uuid
  ownerIssuer      String @map("owner_issuer")
  ownerSubject     String @map("owner_subject")
  petId            String @map("pet_id") @db.Uuid
  linked           Boolean @default(true)
  status           String @default("REQUESTED")
  revision         Int @default(1)
  guardian         Guardian @relation(fields: [sourceOrg, sourceClinic, patientId, guardianId], references: [organizationId, clinicId, patientId, id], onDelete: NoAction, onUpdate: NoAction)
  destination      Clinic @relation(fields: [destinationOrg, destinationClinic], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  request          ReferralRequest?
  response         ReferralResponse?
  events           ReferralEvent[]

  @@unique([sourceOrg, sourceClinic, requestId])
  @@index([destinationOrg, destinationClinic, status], map: "referrals_destination")
  @@index([sourceOrg, sourceClinic, patientId, guardianId], map: "referrals_guardian")
  @@index([ownerIssuer, ownerSubject, petId], map: "referrals_owner")
  @@map("referral_states")
}

model ReferralRequest {
  id                          String @id @db.Uuid
  sourceOrganizationName      String @map("source_organization_name")
  sourceClinicName            String @map("source_clinic_name")
  destinationOrganizationName String @map("destination_organization_name")
  destinationClinicName       String @map("destination_clinic_name")
  patientName                 String @map("patient_name")
  species                     String
  reason                      String
  summary                     String
  authorIssuer                String @map("author_issuer")
  authorSubject               String @map("author_subject")
  requestedAt                 DateTime @default(dbgenerated("clock_timestamp()")) @map("requested_at") @db.Timestamptz(3)
  state                       ReferralState @relation(fields: [id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requestedAt(sort: Desc), id], map: "referrals_chronology")
  @@map("referral_requests")
}

model ReferralResponse {
  id            String @id @db.Uuid
  summary       String
  authorIssuer  String @map("author_issuer")
  authorSubject String @map("author_subject")
  recordedAt    DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  state         ReferralState @relation(fields: [id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@map("referral_responses")
}

model ReferralEvent {
  referralId   String @map("referral_id") @db.Uuid
  revision     Int
  action       String
  actorIssuer  String @map("actor_issuer")
  actorSubject String @map("actor_subject")
  recordedAt   DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  state        ReferralState @relation(fields: [referralId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([referralId, revision])
  @@map("referral_events")
}

model MedicalDocument {
  organizationId  String          @map("organization_id") @db.Uuid
  clinicId        String          @map("clinic_id") @db.Uuid
  patientId       String          @map("patient_id") @db.Uuid
  id              String          @db.Uuid
  assetId         String          @unique @default(dbgenerated("gen_random_uuid()")) @map("asset_id") @db.Uuid
  title           String
  mediaType       String          @map("media_type")
  byteLength      Int             @map("byte_length")
  sha256          String
  uploaderIssuer  String          @map("uploader_issuer")
  uploaderSubject String          @map("uploader_subject")
  ready           Boolean         @default(false)
  recordedAt      DateTime        @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  recipients      String[]        @default([]) @db.Uuid
  revision        Int             @default(0)
  sharingIssuer   String?         @map("sharing_issuer")
  sharingSubject  String?         @map("sharing_subject")
  patient         Patient         @relation(fields: [organizationId, clinicId, patientId], references: [organizationId, clinicId, id], onUpdate: NoAction, onDelete: NoAction)
  events          DocumentEvent[]

  @@id([organizationId, clinicId, patientId, id])
  @@index([organizationId, clinicId, patientId, recordedAt(sort: Desc), assetId], map: "document_chronology")
  @@map("medical_documents")
}

model DocumentEvent {
  eventId        BigInt          @id @default(autoincrement()) @map("event_id")
  organizationId String          @map("organization_id") @db.Uuid
  clinicId       String          @map("clinic_id") @db.Uuid
  patientId      String          @map("patient_id") @db.Uuid
  documentId     String          @map("document_id") @db.Uuid
  action         String
  actorIssuer    String          @map("actor_issuer")
  actorSubject   String          @map("actor_subject")
  recordedAt     DateTime        @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  revision       Int
  guardianIds    String[]        @map("guardian_ids") @db.Uuid
  document       MedicalDocument @relation(fields: [organizationId, clinicId, patientId, documentId], references: [organizationId, clinicId, patientId, id], onDelete: NoAction, onUpdate: NoAction)

  @@map("document_events")
}

model InventoryWarehouse {
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  id             String @db.Uuid
  name           String
  revision       Int
  actorIssuer    String @map("actor_issuer")
  actorSubject   String @map("actor_subject")
  clinic         Clinic @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  balances       StockBalance[]
  outgoing       StockMovement[] @relation("MovementOrigin")
  incoming       StockMovement[] @relation("MovementDestination")

  @@id([organizationId, clinicId, id])
  @@map("inventory_warehouses")
}

model InventoryItem {
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  id             String @db.Uuid
  name           String
  sku            String
  unit           String
  revision       Int
  actorIssuer    String @map("actor_issuer")
  actorSubject   String @map("actor_subject")
  clinic         Clinic @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  balances       StockBalance[]
  movements      StockMovement[]

  @@id([organizationId, clinicId, id])
  @@map("inventory_items")
}

model StockBalance {
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  warehouseId    String @map("warehouse_id") @db.Uuid
  itemId         String @map("item_id") @db.Uuid
  lot            String
  quantity       Decimal @db.Decimal(18,3)
  warehouse      InventoryWarehouse @relation(fields: [organizationId, clinicId, warehouseId], references: [organizationId, clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  item           InventoryItem @relation(fields: [organizationId, clinicId, itemId], references: [organizationId, clinicId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([organizationId, clinicId, warehouseId, itemId, lot])
  @@map("stock_balances")
}

model StockMovement {
  ledgerSequence BigInt @default(autoincrement()) @map("ledger_sequence")
  itemName String @map("item_name")
  sku String
  unit String
  fromWarehouseName String? @map("from_warehouse_name")
  toWarehouseName String? @map("to_warehouse_name")
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  id             String @db.Uuid
  itemId         String @map("item_id") @db.Uuid
  kind           String
  fromWarehouseId String? @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String? @map("to_warehouse_id") @db.Uuid
  lot            String
  reason         String
  quantity       Decimal @db.Decimal(18,3)
  fromBalance    Decimal? @map("from_balance") @db.Decimal(18,3)
  toBalance      Decimal? @map("to_balance") @db.Decimal(18,3)
  recordedAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  actorIssuer    String @map("actor_issuer")
  actorSubject   String @map("actor_subject")
  origin         InventoryWarehouse? @relation("MovementOrigin", fields: [organizationId, clinicId, fromWarehouseId], references: [organizationId, clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  destination    InventoryWarehouse? @relation("MovementDestination", fields: [organizationId, clinicId, toWarehouseId], references: [organizationId, clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  item           InventoryItem @relation(fields: [organizationId, clinicId, itemId], references: [organizationId, clinicId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([organizationId, clinicId, id])
  @@index([organizationId, clinicId, ledgerSequence(sort: Desc)], map: "stock_chronology")
  @@index([organizationId, clinicId, itemId], map: "stock_item_history")
  @@map("stock_movements")
}

model ExchangePackage {
  organizationId       String @map("organization_id") @db.Uuid
  clinicId             String @map("clinic_id") @db.Uuid
  id                   String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceOrganizationId String @map("source_organization_id") @db.Uuid
  sourceClinicId       String @map("source_clinic_id") @db.Uuid
  sourcePackageId      String @map("source_package_id") @db.Uuid
  archiveSha256        String @map("archive_sha256")
  byteLength           Int @map("byte_length")
  manifest             Json @db.JsonB
  recordDigests        Json @map("record_digests") @db.JsonB
  clinic               Clinic @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  receipts             ExchangeReceipt[]
  import               ExchangeImport?

  @@id([organizationId, clinicId, id])
  @@unique([organizationId, clinicId, sourceOrganizationId, sourceClinicId, sourcePackageId], map: "exchange_package_source")
  @@map("exchange_packages")
}

model ExchangeReceipt {
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  id             String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId      String @map("package_id") @db.Uuid
  actorIssuer    String @map("actor_issuer")
  actorSubject   String @map("actor_subject")
  stagedAt       DateTime @default(dbgenerated("clock_timestamp()")) @map("staged_at") @db.Timestamptz(3)
  package        ExchangePackage @relation(fields: [organizationId, clinicId, packageId], references: [organizationId, clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  imports        ExchangeImport[]

  @@id([organizationId, clinicId, id])
  @@unique([organizationId, clinicId, packageId, actorIssuer, actorSubject], map: "exchange_operator_receipt")
  @@map("exchange_receipts")
}

model ExchangePatient {
  organizationId       String @map("organization_id") @db.Uuid
  clinicId             String @map("clinic_id") @db.Uuid
  id                   String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId            String @map("patient_id") @db.Uuid
  sourceOrganizationId String @map("source_organization_id") @db.Uuid
  sourceClinicId       String @map("source_clinic_id") @db.Uuid
  sourcePatientId      String @map("source_patient_id") @db.Uuid
  patient              Patient @relation(fields: [organizationId, clinicId, patientId], references: [organizationId, clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  imports              ExchangeImport[]
  records              ExchangeRecord[]

  @@id([organizationId, clinicId, id])
  @@unique([organizationId, clinicId, sourceOrganizationId, sourceClinicId, sourcePatientId], map: "exchange_source_patient")
  @@index([organizationId, clinicId, patientId], map: "exchange_patients_local")
  @@map("exchange_patients")
}

model ExchangeImport {
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  packageId      String @map("package_id") @db.Uuid
  receiptId      String @map("receipt_id") @db.Uuid
  mappingId      String @map("mapping_id") @db.Uuid
  choice         String
  insertedCount  Int @map("inserted_count")
  skippedCount   Int @map("skipped_count")
  importedAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("imported_at") @db.Timestamptz(3)
  package        ExchangePackage @relation(fields: [organizationId, clinicId, packageId], references: [organizationId, clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  receipt        ExchangeReceipt @relation(fields: [organizationId, clinicId, receiptId], references: [organizationId, clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  mapping        ExchangePatient @relation(fields: [organizationId, clinicId, mappingId], references: [organizationId, clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  records        ExchangeRecord[]

  @@id([organizationId, clinicId, packageId])
  @@map("exchange_imports")
}

model ExchangeRecord {
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  id             String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mappingId      String @map("mapping_id") @db.Uuid
  packageId      String @map("package_id") @db.Uuid
  sourceRecordId String @map("source_record_id") @db.Uuid
  digest         String
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  record         Json @db.JsonB
  mapping        ExchangePatient @relation(fields: [organizationId, clinicId, mappingId], references: [organizationId, clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  import         ExchangeImport @relation(fields: [organizationId, clinicId, packageId], references: [organizationId, clinicId, packageId], onDelete: NoAction, onUpdate: NoAction)

  @@id([organizationId, clinicId, id])
  @@unique([organizationId, clinicId, mappingId, sourceRecordId], map: "exchange_record_source")
  @@index([organizationId, clinicId, mappingId, occurredAt(sort: Desc), id], map: "exchange_records_chronology")
  @@map("exchange_records")
}

model ExchangeExportEvent {
  patient                   Patient @relation(fields: [organizationId, clinicId, patientId], references: [organizationId, clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  packageId                 String @id @map("package_id") @db.Uuid
  organizationId            String @map("organization_id") @db.Uuid
  clinicId                  String @map("clinic_id") @db.Uuid
  patientId                 String @map("patient_id") @db.Uuid
  petId                     String @map("pet_id") @db.Uuid
  destinationOrganizationId String @map("destination_organization_id") @db.Uuid
  destinationClinicId       String @map("destination_clinic_id") @db.Uuid
  encounterIds              String[] @map("encounter_ids") @db.Uuid
  assetIds                  String[] @map("asset_ids") @db.Uuid
  includeOwner              Boolean @map("include_owner")
  actorIssuer               String @map("actor_issuer")
  actorSubject              String @map("actor_subject")
  recordedAt                DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)

  @@map("exchange_export_events")
}
