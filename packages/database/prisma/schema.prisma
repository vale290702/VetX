generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  directoryRevision Int @default(0) @map("directory_revision")
  clinics     Clinic[]
  memberships OrganizationMembership[]
  directoryEvents DirectoryEvent[]

  @@map("organizations")
}

model Clinic {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  grants         ClinicGrant[]

  @@unique([organizationId, id])
  @@map("clinics")
}

model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityIssuer  String   @map("identity_issuer")
  identitySubject String   @map("identity_subject")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships     OrganizationMembership[]

  @@unique([identityIssuer, identitySubject])
  @@map("users")
}

enum OrganizationRole {
  ADMIN
  STAFF

  @@map("organization_role")
}

model OrganizationMembership {
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicGrants   ClinicGrant[]

  @@id([organizationId, userId])
  @@index([userId, organizationId])
  @@map("organization_memberships")
}

model ClinicGrant {
  organizationId String                 @map("organization_id") @db.Uuid
  clinicId       String                 @map("clinic_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  membership     OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  clinic         Clinic                 @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, clinicId, userId])
  @@index([organizationId, userId])
  @@map("clinic_grants")
}

model DirectoryEvent {
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision       Int
  actorIssuer    String       @map("actor_issuer")
  actorSubject   String       @map("actor_subject")
  action         String
  target         String
  details        Json         @db.JsonB
  recordedAt     DateTime     @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)

  @@id([organizationId, revision])
  @@map("directory_events")
}
