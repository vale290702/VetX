{
  "name": "vetx",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @vetx/testing test:e2e",
    "compose": "docker compose --env-file .env -f infrastructure/compose.yaml",
    "db:generate": "pnpm --filter @vetx/database db:generate",
    "db:validate": "pnpm --filter @vetx/database db:validate",
    "db:migrate": "turbo run build --filter=@vetx/config && pnpm --filter @vetx/database db:migrate",
    "generate:api": "turbo run build --filter=@vetx/api && pnpm --filter @vetx/api openapi:generate && pnpm --filter @vetx/api-client generate",
    "test:integration": "turbo run build --filter=@vetx/api --filter=@vetx/worker && pnpm --filter @vetx/testing test:integration"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^24.10.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.6",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "turbo": "^2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
